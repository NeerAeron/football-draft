{
  "name": "football-draft",
  "version": "0.44.0",
  "private": true,
  "type": "module",
  "description": "Football Draft Challenge: draft an XI and play a continuous 11v11 football simulation.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev/serve.mjs --live",
    "serve": "node scripts/dev/serve.mjs",
    "test": "node scripts/dev/test.mjs",
    "test:fast": "node scripts/dev/test.mjs --fast",
    "test:browser": "node scripts/dev/browser.mjs --no-shots",
    "shots": "node scripts/dev/browser.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run test:fast",
    "verify": "npm run format:check && npm run lint && npm test && npm run test:browser",
    "sim:fingerprint": "node scripts/dev/sim-fingerprint.mjs",
    "data:fetch": "node scripts/data/fetch-source.mjs",
    "data:build": "node scripts/data/build.mjs",
    "preload": "node scripts/dev/preload.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "flag-icons": "7.6.0",
    "globals": "15.15.0",
    "prettier": "3.9.10",
    "svgo": "4.1.0"
  }
}
